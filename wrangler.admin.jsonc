{
  "name": "eco-archive-admin",
  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "vars": {
    "GITHUB_OWNER": "progen-ai-kr",
    "GITHUB_REPO": "eco-archive-gpu",
    "GITHUB_REPOS": "eco-archive-gpu,eco-archive-aura",
    "GITHUB_BRANCH": "main",
    "ADMIN_ENABLED": "true",
    "ADMIN_STANDALONE": "true",
    "ADMIN_URL": "https://eco-archive-admin.progen-web.workers.dev/admin",
    "PUBLIC_SITE_URL": "https://eco-archive-gpu.progen-web.workers.dev"
  }
}
